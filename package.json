{
  "name": "cfagentmail",
  "version": "0.1.0",
  "description": "AgentMail clone built natively on the Cloudflare ecosystem",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cfagentmail-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cfagentmail-db --remote"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "email",
    "agentmail",
    "ai-agents",
    "d1",
    "r2"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.7.2",
    "postal-mime": "^2.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.4",
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "wrangler": "^3.111.0"
  }
}

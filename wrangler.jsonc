{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfagentmail",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_DO",
        "class_name": "InboxRealtimeDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InboxRealtimeDO"]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfagentmail-db",
      "database_id": "cfagentmail-db-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "cfagentmail-attachments"
    }
  ],
  "vars": {
    "DEFAULT_DOMAIN": "cfagentmail.com",
    "ALLOW_AUTO_PROVISION_INBOX": "true"
  }
}
